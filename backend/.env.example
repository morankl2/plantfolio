PERENUAL_API_KEY=your_perenual_api_key_here

# Set to true to serve local fixture data (app/mock_data.py) instead of
# calling the real Perenual API — for UI development/testing without
# spending the free tier's 100-requests/day quota. Set back to false to
# test against real data.
MOCK_PERENUAL=false

# Google OAuth client ID (from Google Cloud Console > APIs & Services > Credentials).
# Must match the client ID used by the frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# Origin the frontend dev server runs on, for CORS.
FRONTEND_ORIGIN=http://localhost:5173
